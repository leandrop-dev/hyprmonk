[Unit]
Description=hyprmonk shell (Quickshell)
Documentation=https://github.com/leandrop-dev/hyprmonk
PartOf=graphical-session.target
After=graphical-session.target
# Plasma reaches graphical-session.target too; only start under Hyprland.
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
# NVIDIA's explicit sync (580 driver, egl-wayland 1.1.24) leaks four fences each
# time a window shows or hides. The shell does that all day, and it froze after
# about a day, out of file descriptors.
Environment=__NV_DISABLE_EXPLICIT_SYNC=1
# Qt's own PipeWire backend pins the sounds' stream to the output by id and
# will not let it be moved: when the headphone correction's filter comes or
# goes (services/AudioEffects.qml) the stream dies and the sounds stop.
# Through PulseAudio (pipewire-pulse) it is moved like any app's.
Environment=QT_AUDIO_BACKEND=pulseaudio
ExecStart=/usr/bin/qs -c hyprmonk
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
