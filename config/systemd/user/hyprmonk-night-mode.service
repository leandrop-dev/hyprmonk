[Unit]
Description=hyprmonk night mode (a PipeWire filter-chain)
Documentation=https://github.com/leandrop-dev/hyprmonk
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service
# Plasma reaches graphical-session.target too; only start under Hyprland.
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland
# Written by the shell while night mode is on (services/AudioEffects.qml)
# and removed when it is turned off, so it starts at login only if left on.
ConditionPathExists=%h/.local/state/hyprmonk/audio/night-mode.conf

[Service]
ExecStart=/usr/bin/pipewire -c %h/.local/state/hyprmonk/audio/night-mode.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
