[Unit]
Description=hyprmonk idle: lock and screens off (hypridle)
Documentation=https://github.com/leandrop-dev/hyprmonk
PartOf=graphical-session.target
After=graphical-session.target hyprmonk-shell.service
# Plasma reaches graphical-session.target too; only start under Hyprland.
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
# The shell's copy with the times from Settings > Power, once there is one
# (services/Idle.qml); the repo's config/hypr/hypridle.conf until then.
ExecStart=/bin/sh -c 'conf="%h/.local/state/hyprmonk/hypridle.conf"; test -e "$conf" || conf="%h/.config/hypr/hypridle.conf"; exec /usr/bin/hypridle -c "$conf"'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
