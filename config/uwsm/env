# Session environment, read by uwsm before Hyprland and every unit start.

# Cursor (`install.sh cursor` downloads it)
export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE=24

# NVIDIA (proprietary driver): hardware video decoding and GLX vendor. Only
# when that driver is loaded: on AMD or Intel these would break decoding.
if [ -e /proc/driver/nvidia/version ]; then
    export LIBVA_DRIVER_NAME=nvidia
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    export NVD_BACKEND=direct
fi

# Toolkits on Wayland
export QT_QPA_PLATFORM="wayland;xcb"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
# Qt apps in the tone: qt6ct reads ~/.config/qt6ct/qt6ct.conf, written by the
# shell (ThemeOutputs.qml), and reapplies it when it changes
export QT_QPA_PLATFORMTHEME=qt6ct
export ELECTRON_OZONE_PLATFORM_HINT=auto

# Icons in the shell: Yaru (packages/aur.txt). Read once at its start, so it
# does not follow the tone as GTK apps do (Theme.qml); dark, Yaru's orange.
export QS_ICON_THEME=Yaru-dark
