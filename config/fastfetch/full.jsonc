// Full: everything, for when something needs checking.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "padding": { "right": 3, "top": 1 } },
    "display": { "separator": "  ", "key": { "width": 11 } },
    "modules": [
        "break",
        "title",
        "separator",
        { "type": "os", "key": "os" },
        { "type": "host", "key": "host" },
        { "type": "kernel", "key": "kernel" },
        { "type": "uptime", "key": "uptime" },
        { "type": "packages", "key": "packages" },
        { "type": "shell", "key": "shell" },
        { "type": "display", "key": "display" },
        { "type": "wm", "key": "wm" },
        { "type": "theme", "key": "theme" },
        { "type": "icons", "key": "icons" },
        { "type": "terminalfont", "key": "font" },
        { "type": "cursor", "key": "cursor" },
        { "type": "terminal", "key": "terminal" },
        { "type": "cpu", "key": "cpu" },
        { "type": "gpu", "key": "gpu" },
        { "type": "memory", "key": "memory" },
        { "type": "swap", "key": "swap" },
        { "type": "disk", "key": "disk" },
        { "type": "localip", "key": "ip" },
        { "type": "locale", "key": "locale" },
        "break",
        "colors"
    ]
}
