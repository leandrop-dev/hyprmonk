// Compact: the small logo and what is worth a glance.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "type": "small", "padding": { "right": 2 } },
    "display": { "separator": "  " },
    "modules": [
        { "type": "os", "key": "os    ", "format": "{pretty-name}" },
        { "type": "kernel", "key": "kern  ", "format": "{release}" },
        { "type": "wm", "key": "wm    ", "format": "{pretty-name}" },
        { "type": "packages", "key": "pkgs  ", "format": "{all}" },
        { "type": "memory", "key": "mem   ", "format": "{used} / {total}" },
        { "type": "uptime", "key": "up    " }
    ]
}
