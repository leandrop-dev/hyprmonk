// Sections: headed blocks and no logo, for a narrow terminal.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": null,
    "display": { "separator": "  ", "key": { "width": 12 } },
    "modules": [
        "break",
        { "type": "custom", "format": "{#keys}╭─ system ──────────────────────" },
        { "type": "os", "key": "│ os", "format": "{pretty-name}" },
        { "type": "kernel", "key": "│ kernel", "format": "{release}" },
        { "type": "packages", "key": "│ packages", "format": "{all}" },
        { "type": "custom", "format": "{#keys}├─ desktop ─────────────────────" },
        { "type": "wm", "key": "│ wm", "format": "{pretty-name}" },
        { "type": "shell", "key": "│ shell", "format": "{pretty-name}" },
        { "type": "terminal", "key": "│ terminal", "format": "{pretty-name}" },
        { "type": "custom", "format": "{#keys}├─ hardware ────────────────────" },
        { "type": "cpu", "key": "│ cpu", "format": "{name}" },
        { "type": "gpu", "key": "│ gpu", "format": "{name}" },
        { "type": "memory", "key": "│ memory", "format": "{used} / {total}" },
        { "type": "custom", "format": "{#keys}╰───────────────────────────────" }
    ]
}
