// Tree: three branches, each in a colour of the terminal's own palette.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "padding": { "right": 3, "top": 1 } },
    "display": { "separator": "  ", "key": { "width": 12 } },
    "modules": [
        "break",
        { "type": "os", "key": " system", "keyColor": "33", "format": "{pretty-name}" },
        { "type": "kernel", "key": "├ kernel", "keyColor": "33", "format": "{release}" },
        { "type": "packages", "key": "├ packages", "keyColor": "33", "format": "{all}" },
        { "type": "uptime", "key": "└ uptime", "keyColor": "33" },
        "break",
        { "type": "wm", "key": " desktop", "keyColor": "32", "format": "{pretty-name}" },
        { "type": "shell", "key": "├ shell", "keyColor": "32", "format": "{pretty-name}" },
        { "type": "terminal", "key": "├ terminal", "keyColor": "32", "format": "{pretty-name}" },
        { "type": "terminalfont", "key": "└ font", "keyColor": "32" },
        "break",
        { "type": "cpu", "key": " hardware", "keyColor": "34", "format": "{name}" },
        { "type": "gpu", "key": "├ gpu", "keyColor": "34", "format": "{name}" },
        { "type": "memory", "key": "├ memory", "keyColor": "34", "format": "{used} / {total}" },
        { "type": "disk", "key": "└ disk", "keyColor": "34", "folders": "/", "format": "{size-used} / {size-total}" }
    ]
}
